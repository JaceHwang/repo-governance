#!/bin/sh
set -eu
project_root=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd)

sh "$project_root/tests/test-install.sh"
sh "$project_root/tests/test-project-release.sh"
sh "$project_root/tests/test-github-policy.sh"
for file in "$project_root"/release-please-config.json \
            "$project_root"/.release-please-manifest.json \
            "$project_root"/.governance/release/*.json
do
  python3 -m json.tool "$file" >/dev/null
done
for file in "$project_root"/.github/workflows/*.yml; do
  ruby -e 'require "yaml"; YAML.safe_load(File.read(ARGV[0]), aliases: true)' "$file"
done
(
  cd "$project_root"
  go run github.com/rhysd/actionlint/cmd/actionlint@v1.7.7 .github/workflows/*.yml
)
if grep -R -n -E '\[TODO|TODO:|TBD' "$project_root/skill"; then
  printf 'unfinished skill placeholder detected\n' >&2
  exit 1
fi
printf 'PASS: repository-specific governance checks\n'
